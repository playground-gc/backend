# ─── Copy this file to .env and fill in values ────────────────────────────────

# PostgreSQL
POSTGRES_USER=synthbull
POSTGRES_PASSWORD=synthbull_pass

# JWT (change in production!)
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRE_MINUTES=1440

# Bot credentials
MM_BOT_PASSWORD=mmbot_pass
ALPHA_BOT_PASSWORD=alphabot_pass

# ─── Derived URLs (used by Python services) ────────────────────────────────────
REDIS_URL=redis://redis:6379
POSTGRES_URL=postgresql://synthbull:synthbull_pass@postgres:5432/synthbull

# ─── Matching engine address (used by api-gateway and market-maker-bot) ────────
ENGINE_HOST=matching-engine
ENGINE_PORT=9000

# ─── Stocks config path (mounted into containers) ──────────────────────────────
STOCKS_CONFIG=/shared/stocks.yaml
